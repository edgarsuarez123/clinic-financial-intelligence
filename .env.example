# Local development only. Generate independent URL-safe secrets, e.g.
# python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
QUERY_DB_PASSWORD=
SESSION_MINUTES=30
LOGIN_LIMIT=5
LOGIN_WINDOW_SECONDS=900
LOG_LEVEL=INFO

# Optional Phase 5; configure config/query.json before enabling. Never commit a real key.
LLM_API_KEY=

APP_ENV=dev
CONFIG_DIRECTORY=./config
API_PORT=8000
UI_PORT=8501
CONFIRM_DISPOSABLE_TEST_DATABASE=false
