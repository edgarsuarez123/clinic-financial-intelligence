FROM python:3.12-slim
WORKDIR /srv/clinic
COPY pyproject.toml requirements-test.lock ./
COPY app ./app
RUN pip install --no-cache-dir -r requirements-test.lock && pip install --no-cache-dir --no-deps .
COPY migrations ./migrations
COPY config ./config
COPY examples ./examples
COPY ui ./ui
COPY scripts ./scripts
COPY tests ./tests
CMD ["python", "scripts/run_container_tests.py"]
